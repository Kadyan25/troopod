{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'purelane-combos.js' | asset_url }}" defer="defer"></script>

<section class="purelane-scope purelane-sec" id="purelane-combos-{{ section.id }}" data-purelane-combos>
  <div class="wrap">
    {%- render 'purelane-section-heading',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      lede: section.settings.lede
    -%}

    {%- assign combo_blocks = section.blocks | where: 'type', 'combo_ref' -%}
    {%- if combo_blocks.size > 0 -%}
      <div class="purelane-comborail purelane-rv">
        {%- for block in combo_blocks -%}
          {%- liquid
            assign combo = block.settings.combo
            if combo == blank
              continue
            endif
            assign products = combo.fields.products.value
            assign captions = combo.fields.item_captions.value
            assign price = combo.fields.price.value
            assign compare_at = combo.fields.compare_at_price.value
            assign variant_ids = ''
          -%}
          <article
            class="purelane-combo purelane-glass {% if combo.fields.featured.value %}purelane-hero-combo{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="purelane-tray">
              {%- if combo.fields.savings_label.value != blank -%}
                <span class="purelane-save">{{ combo.fields.savings_label.value }}</span>
              {%- endif -%}
              {%- if combo.fields.flag.value != blank -%}
                <span class="purelane-flag">{{ combo.fields.flag.value }}</span>
              {%- endif -%}
              <div class="purelane-stack">
                {%- for product in products -%}
                  {%- liquid
                    assign caption = captions[forloop.index0]
                    assign v = product.selected_or_first_available_variant
                    assign variant_ids = variant_ids | append: v.id | append: ','
                  -%}
                  <span class="purelane-it">
                    {%- if product.featured_media -%}
                      <img
                        class="purelane-pimg"
                        src="{{ product.featured_media | image_url: width: 200 }}"
                        alt="{{ product.title | escape }}"
                        loading="lazy"
                        width="{{ product.featured_media.width }}"
                        height="{{ product.featured_media.height }}"
                      >
                    {%- endif -%}
                    <span>{{ caption | default: product.title }}</span>
                  </span>
                  {%- unless forloop.last -%}<span class="purelane-plus" aria-hidden="true">+</span>{%- endunless -%}
                {%- endfor -%}
              </div>
            </div>
            <div class="purelane-body">
              <h3>{{ combo.fields.title.value }}</h3>
              <div class="purelane-cnt">{{ 'purelane.combos.products_count' | t: count: products.size }}</div>
              {%- if combo.fields.description.value != blank -%}
                <p class="purelane-inc">{{ combo.fields.description.value }}</p>
              {%- endif -%}
              {% render 'purelane-price', price: price, compare_at_price: compare_at, variant: 'combo' %}
              <div class="purelane-fine">{{ section.settings.fine_print }}</div>
              <button
                type="button"
                class="purelane-btn {% if combo.fields.featured.value %}purelane-btn-primary{% else %}purelane-btn-ghost{% endif %} purelane-combo-add"
                data-variant-ids="{{ variant_ids | remove_last: ',' }}"
              >
                <span>{{ 'purelane.combos.shop_bundle' | t }}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"></path></svg>
              </button>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <div class="purelane-swipecue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"></path></svg>
        {{ 'purelane.combos.swipe_hint' | t }}
      </div>
      {%- if section.settings.rail_note != blank -%}
        <p class="purelane-railnote">{{ section.settings.rail_note }}</p>
      {%- endif -%}
    {%- else -%}
      <div class="purelane-shop-empty purelane-rv">{{ 'purelane.combos.pick_combos' | t }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane: Combos",
  "class": "purelane-combos-section",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    { "type": "text", "id": "fine_print", "label": "Fine print on every card", "default": "Inclusive of all taxes · COD available" },
    { "type": "textarea", "id": "rail_note", "label": "Note below the rail", "default": "\"Shop bundle\" adds every product in that combo to your cart at its own price — this build doesn't wire up an automatic bundle discount (see build notes)." }
  ],
  "blocks": [
    {
      "type": "combo_ref",
      "name": "Combo",
      "settings": [
        { "type": "metaobject", "id": "combo", "metaobject_type": "combo", "label": "Combo entry" }
      ]
    }
  ],
  "presets": [
    { "name": "Purelane: Combos" }
  ]
}
{% endschema %}
