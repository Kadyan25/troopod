# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Your dev store's *.myshopify.com domain, no protocol.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API access token from a custom app (Settings > Apps > Develop apps)
# with scopes: write_products, read_products, write_metaobjects,
# read_metaobjects, write_metaobject_definitions, read_metaobject_definitions
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
